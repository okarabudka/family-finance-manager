#!/bin/sh
# Pre-commit hook: coding standards and static analysis inside the app container.
# Install with: make install-hooks
set -e

if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')" ]; then
    exit 0
fi

if [ -z "$(docker compose ps -q --status running app 2>/dev/null)" ]; then
    echo "pre-commit: app container is not running, skipping checks (start it with 'make up')."
    exit 0
fi

make --no-print-directory cs stan
