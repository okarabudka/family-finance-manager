# Committed defaults for local development. Values here are placeholders only.
# Put real values (bot token, secrets, production DSNs) into .env.local, which is git-ignored.
# Real environment variables win over .env files.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:secret@127.0.0.1:5432/family_finance?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@family-finance.local
###< symfony/mailer ###

###> app ###
REDIS_URL=redis://127.0.0.1:6379
STORAGE_LOCAL_PATH=%kernel.project_dir%/var/uploads
# Leave the token empty to run the bot offline: replies are written to the log instead of the Telegram API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
###< app ###
