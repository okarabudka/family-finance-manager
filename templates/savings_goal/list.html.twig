{% extends 'base.html.twig' %}

{% block title %}{{ 'savings_goal.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">{{ 'savings_goal.title'|trans }}</h1>
    <a href="{{ path('savings_goal_new') }}"
       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
        + {{ 'savings_goal.new_short'|trans }}
    </a>
</div>

{% if goals is empty %}
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
        {{ 'savings_goal.empty'|trans }}
        <a href="{{ path('savings_goal_new') }}" class="text-indigo-600 hover:underline ml-1">{{ 'savings_goal.create_first'|trans }}</a>
    </div>
{% else %}
<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'savings_goal.column.name'|trans }}</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">{{ 'savings_goal.column.target'|trans }}</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'savings_goal.column.deadline'|trans }}</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'savings_goal.column.status'|trans }}</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {% for goal in goals %}
            {% set statusColor = {
                'active':   'bg-green-100 text-green-700',
                'completed': 'bg-blue-100 text-blue-700',
                'archived': 'bg-gray-100 text-gray-500'
            } %}
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-gray-900">
                    {{ goal.name }}
                    {% if goal.description %}
                        <div class="text-xs text-gray-400 font-normal">{{ goal.description }}</div>
                    {% endif %}
                </td>
                <td class="px-4 py-3 text-right font-semibold text-gray-800">
                    {% if goal.targetAmount %}
                        {{ goal.targetAmount|number_format(2, '.', ',') }} EUR
                    {% else %}
                        <span class="text-gray-400">—</span>
                    {% endif %}
                </td>
                <td class="px-4 py-3 text-gray-500">
                    {% if goal.targetDate %}
                        {{ goal.targetDate|date('Y-m-d') }}
                    {% else %}
                        <span class="text-gray-300">{{ 'savings_goal.no_deadline'|trans }}</span>
                    {% endif %}
                </td>
                <td class="px-4 py-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                 {{ statusColor[goal.status.value] ?? 'bg-gray-100 text-gray-500' }}">
                        {{ goal.status|trans }}
                    </span>
                </td>
                <td class="px-4 py-3 text-center space-x-2">
                    <a href="{{ path('savings_goal_edit', {id: goal.id}) }}"
                       class="text-indigo-600 hover:underline text-xs">{{ 'common.edit'|trans }}</a>
                    <form method="post" action="{{ path('savings_goal_delete', {id: goal.id}) }}"
                          class="inline"
                          onsubmit="return confirm({{ 'savings_goal.confirm_delete'|trans|json_encode }});">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_savings_goal_' ~ goal.id) }}">
                        <button type="submit" class="text-red-600 hover:underline text-xs">{{ 'common.delete'|trans }}</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
