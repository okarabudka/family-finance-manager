{% extends 'base.html.twig' %}

{% block title %}{{ title }} — Family Finance Manager{% endblock %}

{% block content %}
<div class="mb-6 flex items-center gap-4">
    <a href="{{ path('savings_goal_list') }}" class="text-indigo-600 hover:underline text-sm">&larr; Back to savings goals</a>
    <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-xl">
    {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}

    <div>
        {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.name, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div>
        {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.description, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.description) }}
    </div>

    <div>
        {{ form_label(form.account, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.account, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.account) }}
    </div>

    <div>
        {{ form_label(form.targetAmount, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.targetAmount, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.targetAmount) }}
    </div>

    <div>
        {{ form_label(form.targetDate, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.targetDate, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.targetDate) }}
    </div>

    <div>
        {{ form_label(form.status, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.status, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.status) }}
    </div>

    <div class="flex gap-3 pt-2">
        <button type="submit"
                class="px-6 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700">
            Save
        </button>
        <a href="{{ path('savings_goal_list') }}"
           class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200">
            Cancel
        </a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
