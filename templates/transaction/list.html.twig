{% extends 'base.html.twig' %}

{% block title %}Transactions — Family Finance Manager{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Transactions</h1>
    <a href="{{ path('transaction_new') }}"
       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
        + Add Transaction
    </a>
</div>

{# Filters #}
<div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="{{ path('transaction_list') }}" class="flex flex-wrap gap-4 items-end">
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Type</label>
            <select name="type" class="rounded border-gray-300 text-sm px-2 py-1.5 border">
                <option value="">All types</option>
                {% for type in transactionTypes %}
                    <option value="{{ type.value }}" {{ filters.type is defined and filters.type == type.value ? 'selected' : '' }}>
                        {{ type.value|capitalize }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">From</label>
            <input type="date" name="from" value="{{ filters.from ?? '' }}"
                   class="rounded border-gray-300 text-sm px-2 py-1.5 border">
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">To</label>
            <input type="date" name="to" value="{{ filters.to ?? '' }}"
                   class="rounded border-gray-300 text-sm px-2 py-1.5 border">
        </div>
        <div class="flex gap-2">
            <button type="submit"
                    class="px-4 py-1.5 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700">
                Filter
            </button>
            <a href="{{ path('transaction_list') }}"
               class="px-4 py-1.5 bg-gray-100 text-gray-700 text-sm rounded hover:bg-gray-200">
                Reset
            </a>
        </div>
    </form>
</div>

{# Transactions table #}
<div class="bg-white rounded-lg shadow overflow-hidden">
    {% if transactions.totalItemCount == 0 %}
        <div class="text-center py-12 text-gray-400">
            No transactions found.
            <a href="{{ path('transaction_new') }}" class="text-indigo-600 hover:underline ml-1">Add one</a>
        </div>
    {% else %}
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Account</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for transaction in transactions %}
                {% set isExpense = transaction.type.value in ['expense', 'transfer'] %}
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-gray-500 whitespace-nowrap">
                        {{ transaction.executedAt|date('Y-m-d') }}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                        {% set typeColor = {
                            'expense': 'red',
                            'income': 'green',
                            'transfer': 'blue',
                            'refund': 'yellow',
                            'adjustment': 'gray'
                        } %}
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                     bg-{{ typeColor[transaction.type.value] ?? 'gray' }}-100
                                     text-{{ typeColor[transaction.type.value] ?? 'gray' }}-800">
                            {{ transaction.type.value|capitalize }}
                        </span>
                    </td>
                    <td class="px-4 py-3 text-gray-900 max-w-xs truncate">
                        {{ transaction.description ?? '—' }}
                    </td>
                    <td class="px-4 py-3 text-gray-500">
                        {% if transaction.category %}
                            {% if transaction.category.icon %}{{ transaction.category.icon }} {% endif %}
                            {{ transaction.category.name }}
                        {% else %}
                            <span class="text-gray-300">—</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-gray-500 whitespace-nowrap">
                        {% if transaction.sourceAccount %}
                            {{ transaction.sourceAccount.name }}
                            {% if transaction.targetAccount %}
                                → {{ transaction.targetAccount.name }}
                            {% endif %}
                        {% elseif transaction.targetAccount %}
                            {{ transaction.targetAccount.name }}
                        {% else %}
                            <span class="text-gray-300">—</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-right font-semibold whitespace-nowrap
                               {{ isExpense ? 'text-red-600' : 'text-green-600' }}">
                        {{ isExpense ? '-' : '+' }}{{ transaction.amount|number_format(2, '.', ',') }}
                        {{ transaction.currency }}
                    </td>
                    <td class="px-4 py-3 text-center whitespace-nowrap">
                        <a href="{{ path('transaction_edit', {id: transaction.id}) }}"
                           class="text-indigo-600 hover:underline text-xs mr-2">Edit</a>
                        <form method="POST" action="{{ path('transaction_delete', {id: transaction.id}) }}"
                              class="inline"
                              onsubmit="return confirm('Delete this transaction?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete_transaction_' ~ transaction.id) }}">
                            <button type="submit" class="text-red-500 hover:underline text-xs">Delete</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div class="px-4 py-3 border-t border-gray-200 flex items-center justify-between">
        <div class="text-sm text-gray-500">
            Showing {{ transactions.currentPageNumber * transactions.itemNumberPerPage - transactions.itemNumberPerPage + 1 }}
            –{{ min(transactions.currentPageNumber * transactions.itemNumberPerPage, transactions.totalItemCount) }}
            of {{ transactions.totalItemCount }} transactions
        </div>
        <div class="flex gap-1">
            {% if transactions.currentPageNumber > 1 %}
                <a href="{{ path('transaction_list', filters|merge({'page': transactions.currentPageNumber - 1})) }}"
                   class="px-3 py-1 border rounded text-sm hover:bg-gray-50">&laquo; Prev</a>
            {% endif %}

            {% for page in 1..transactions.pageCount %}
                {% if page == transactions.currentPageNumber %}
                    <span class="px-3 py-1 border rounded text-sm bg-indigo-600 text-white">{{ page }}</span>
                {% elseif page == 1 or page == transactions.pageCount or (page >= transactions.currentPageNumber - 2 and page <= transactions.currentPageNumber + 2) %}
                    <a href="{{ path('transaction_list', filters|merge({'page': page})) }}"
                       class="px-3 py-1 border rounded text-sm hover:bg-gray-50">{{ page }}</a>
                {% elseif page == transactions.currentPageNumber - 3 or page == transactions.currentPageNumber + 3 %}
                    <span class="px-3 py-1 text-sm text-gray-400">…</span>
                {% endif %}
            {% endfor %}

            {% if transactions.currentPageNumber < transactions.pageCount %}
                <a href="{{ path('transaction_list', filters|merge({'page': transactions.currentPageNumber + 1})) }}"
                   class="px-3 py-1 border rounded text-sm hover:bg-gray-50">Next &raquo;</a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
