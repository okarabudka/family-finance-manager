{% extends 'base.html.twig' %}

{% block title %}{{ title|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center gap-4">
    <a href="{{ path('transaction_list') }}" class="text-indigo-600 hover:underline text-sm">&larr; {{ 'transaction.back'|trans }}</a>
    <h1 class="text-2xl font-bold text-gray-900">{{ title|trans }}</h1>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
            {{ form_label(form.type, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.type, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.type) }}
        </div>

        <div>
            {{ form_label(form.amount, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.amount, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.amount) }}
        </div>
    </div>

    <div>
        {{ form_label(form.account, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.account, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.account) }}
    </div>

    <div>
        {{ form_label(form.category, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.category, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.category) }}
    </div>

    <div>
        {{ form_label(form.executedAt, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.executedAt, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.executedAt) }}
    </div>

    <div>
        {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.description, {attr: {
            class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border',
            rows: 3,
            placeholder: 'Optional notes…'
        }}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="flex gap-3 pt-2">
        <button type="submit"
                class="px-6 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            {{ 'common.save'|trans }}
        </button>
        <a href="{{ path('transaction_list') }}"
           class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200">
            {{ 'common.cancel'|trans }}
        </a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
