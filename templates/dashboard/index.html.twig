{% extends 'base.html.twig' %}

{% block title %}Dashboard — Family Finance Manager{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
    <a href="{{ path('transaction_new') }}"
       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
        + Add Transaction
    </a>
</div>

{# Account balance cards #}
{% if accounts is empty %}
    <div class="bg-white rounded-lg shadow p-6 text-center text-gray-500 mb-6">
        No accounts yet.
        <a href="{{ path('account_new') }}" class="text-indigo-600 hover:underline ml-1">Create one</a>
    </div>
{% else %}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    {% for account in accounts %}
    <div class="bg-white rounded-lg shadow p-4">
        <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-medium text-gray-500">{{ account.name }}</span>
            <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded">{{ account.type.value }}</span>
        </div>
        <div class="text-2xl font-bold {{ balances[account.id|string] >= 0 ? 'text-green-600' : 'text-red-600' }}">
            {{ balances[account.id|string]|number_format(2, '.', ',') }} {{ account.currency }}
        </div>
        <div class="mt-2">
            <a href="{{ path('account_edit', {id: account.id}) }}" class="text-xs text-indigo-500 hover:underline">Edit</a>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

{# Monthly summary #}
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
        <div class="text-sm text-green-700 font-medium">Income this month</div>
        <div class="text-2xl font-bold text-green-800">{{ monthlyReport.totalIncome|number_format(2, '.', ',') }}</div>
    </div>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="text-sm text-red-700 font-medium">Expenses this month</div>
        <div class="text-2xl font-bold text-red-800">{{ monthlyReport.totalExpenses|number_format(2, '.', ',') }}</div>
    </div>
    <div class="bg-{{ monthlyReport.balance >= 0 ? 'blue' : 'orange' }}-50 border border-{{ monthlyReport.balance >= 0 ? 'blue' : 'orange' }}-200 rounded-lg p-4">
        <div class="text-sm text-{{ monthlyReport.balance >= 0 ? 'blue' : 'orange' }}-700 font-medium">Balance</div>
        <div class="text-2xl font-bold text-{{ monthlyReport.balance >= 0 ? 'blue' : 'orange' }}-800">
            {{ monthlyReport.balance|number_format(2, '.', ',') }}
        </div>
    </div>
</div>

{# Charts #}
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-4">
        <h3 class="text-base font-semibold text-gray-900 mb-4">Expenses by Category</h3>
        {% if categoryLabels is empty %}
            <p class="text-gray-400 text-sm text-center py-8">No expense data for this month.</p>
        {% else %}
            <canvas id="categoryChart" height="250"></canvas>
        {% endif %}
    </div>

    <div class="bg-white rounded-lg shadow p-4">
        <h3 class="text-base font-semibold text-gray-900 mb-4">6-Month Trend</h3>
        <canvas id="trendChart" height="250"></canvas>
    </div>
</div>

{# Category breakdown table #}
{% if monthlyReport.byCategory is not empty %}
<div class="bg-white rounded-lg shadow mb-6">
    <div class="px-4 py-3 border-b border-gray-200">
        <h3 class="text-base font-semibold text-gray-900">Category Breakdown</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">%</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Budget</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for catReport in monthlyReport.byCategory %}
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium text-gray-900">
                        {% if catReport.category.icon %}{{ catReport.category.icon }} {% endif %}
                        {{ catReport.category.name }}
                    </td>
                    <td class="px-4 py-3 text-right text-gray-700">{{ catReport.amount|number_format(2, '.', ',') }}</td>
                    <td class="px-4 py-3 text-right text-gray-500">{{ catReport.percent|number_format(1) }}%</td>
                    <td class="px-4 py-3 text-right">
                        {% if catReport.budgetAmount %}
                            <span class="{{ catReport.budgetUsedPercent > 100 ? 'text-red-600 font-semibold' : 'text-gray-500' }}">
                                {{ catReport.budgetUsedPercent|number_format(0) }}% of {{ catReport.budgetAmount|number_format(0) }}
                            </span>
                        {% else %}
                            <span class="text-gray-300">—</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{# Suggestions / Recommendations #}
{% if suggestions is not empty %}
<div class="mb-6">
    <h3 class="text-base font-semibold text-gray-900 mb-3">Recommendations</h3>
    {% for suggestion in suggestions %}
        {% set priorityColor = suggestion.priority.value >= 4 ? 'red' : (suggestion.priority.value >= 3 ? 'orange' : (suggestion.priority.value >= 2 ? 'yellow' : 'blue')) %}
        <div class="bg-{{ priorityColor }}-50 border border-{{ priorityColor }}-200 rounded-lg p-4 mb-2">
            <div class="font-semibold text-{{ priorityColor }}-800">{{ suggestion.title }}</div>
            <div class="text-sm text-{{ priorityColor }}-700 mt-1">{{ suggestion.message }}</div>
        </div>
    {% endfor %}
</div>
{% endif %}

<script>
{% if categoryLabels is not empty %}
const categoryCtx = document.getElementById('categoryChart').getContext('2d');
new Chart(categoryCtx, {
    type: 'doughnut',
    data: {
        labels: {{ categoryLabels|json_encode|raw }},
        datasets: [{
            data: {{ categoryAmounts|json_encode|raw }},
            backgroundColor: {{ categoryColors|json_encode|raw }},
            borderWidth: 2,
            borderColor: '#fff',
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { position: 'bottom' },
            tooltip: {
                callbacks: {
                    label: (ctx) => ` ${ctx.label}: ${ctx.parsed.toFixed(2)}`
                }
            }
        }
    }
});
{% endif %}

const trendCtx = document.getElementById('trendChart').getContext('2d');
new Chart(trendCtx, {
    type: 'bar',
    data: {
        labels: {{ trendLabels|json_encode|raw }},
        datasets: [
            {
                label: 'Expenses',
                data: {{ trendExpenses|json_encode|raw }},
                backgroundColor: 'rgba(239, 68, 68, 0.6)',
                borderColor: 'rgb(239, 68, 68)',
                borderWidth: 1,
            },
            {
                label: 'Income',
                data: {{ trendIncome|json_encode|raw }},
                backgroundColor: 'rgba(34, 197, 94, 0.6)',
                borderColor: 'rgb(34, 197, 94)',
                borderWidth: 1,
            }
        ]
    },
    options: {
        responsive: true,
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { position: 'bottom' } }
    }
});
</script>
{% endblock %}
