{% extends 'base.html.twig' %}

{% block title %}{{ title|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center gap-4">
    <a href="{{ path('category_list') }}" class="text-indigo-600 hover:underline text-sm">&larr; {{ 'category.back'|trans }}</a>
    <h1 class="text-2xl font-bold text-gray-900">{{ title|trans }}</h1>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-xl">
    {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}

    <div>
        {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.name, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
            {{ form_label(form.type, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.type, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.type) }}
        </div>
        <div>
            {{ form_label(form.icon, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.icon, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.icon) }}
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
            {{ form_label(form.color, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.color, {attr: {class: 'block h-10 w-24 rounded border-gray-300 cursor-pointer border'}}) }}
            {{ form_errors(form.color) }}
        </div>
        <div>
            {{ form_label(form.sortOrder, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.sortOrder, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.sortOrder) }}
        </div>
    </div>

    <div>
        {{ form_label(form.parent, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.parent, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.parent) }}
    </div>

    <div class="flex gap-3 pt-2">
        <button type="submit"
                class="px-6 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700">
            {{ 'common.save'|trans }}
        </button>
        <a href="{{ path('category_list') }}"
           class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200">
            {{ 'common.cancel'|trans }}
        </a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
