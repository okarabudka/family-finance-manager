{% extends 'base.html.twig' %}

{% block title %}{{ 'recommendation.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">{{ 'recommendation.title'|trans }}</h1>
    <p class="text-sm text-gray-500 mt-1">{{ 'recommendation.subtitle'|trans }}</p>
</div>

{% if recommendations is empty %}
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
        {{ 'recommendation.empty'|trans }}
    </div>
{% else %}
<div class="space-y-4">
    {% for rec in recommendations %}
    {% set typeColors = {
        'budget':   'bg-blue-100 text-blue-700',
        'saving':   'bg-green-100 text-green-700',
        'spending': 'bg-amber-100 text-amber-700',
        'alert':    'bg-red-100 text-red-700'
    } %}
    {% set priorityColors = {
        1: 'border-l-gray-300',
        2: 'border-l-yellow-400',
        3: 'border-l-red-500'
    } %}
    <div class="bg-white rounded-lg shadow p-5 border-l-4 {{ priorityColors[rec.priority] ?? 'border-l-gray-300' }}">
        <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                 {{ typeColors[rec.type] ?? 'bg-gray-100 text-gray-500' }}">
                        {{ ('recommendation.type.' ~ rec.type)|trans }}
                    </span>
                    {% if rec.priority >= 3 %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700">
                        {{ 'recommendation.priority_high'|trans }}
                    </span>
                    {% elseif rec.priority == 2 %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-700">
                        {{ 'recommendation.priority_medium'|trans }}
                    </span>
                    {% endif %}
                    <span class="text-xs text-gray-400">{{ rec.period }}</span>
                </div>
                <h3 class="text-sm font-semibold text-gray-900 mb-1">{{ rec.title }}</h3>
                <p class="text-sm text-gray-600">{{ rec.message }}</p>
                <p class="text-xs text-gray-400 mt-2">{{ 'recommendation.generated_at'|trans({'%date%': rec.generatedAt|date('Y-m-d H:i')}) }}</p>
            </div>
            <form method="post" action="{{ path('recommendation_mark_seen', {id: rec.id}) }}" class="flex-shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token('mark_seen_' ~ rec.id) }}">
                <button type="submit"
                        class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-gray-100 rounded hover:bg-gray-200 whitespace-nowrap">
                    {{ 'recommendation.mark_seen'|trans }}
                </button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
