{% extends 'base.html.twig' %}

{% block title %}Settings — Family Finance Manager{% endblock %}

{% block content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Settings</h1>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    {# Left column: Profile + Password #}
    <div class="lg:col-span-2 space-y-6">

        {# Profile #}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-base font-semibold text-gray-900">Profile</h2>
            </div>
            <div class="px-6 py-4">
                {{ form_start(profileForm) }}
                <div class="space-y-4">
                    <div>
                        {{ form_label(profileForm.name, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(profileForm.name, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(profileForm.name) }}
                    </div>
                    <div>
                        {{ form_label(profileForm.email, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(profileForm.email, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(profileForm.email) }}
                    </div>
                    <hr class="border-gray-200">
                    <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Change Password (optional)</p>
                    <div>
                        {{ form_label(profileForm.currentPassword, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(profileForm.currentPassword, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        <p class="mt-1 text-xs text-gray-400">{{ form_help(profileForm.currentPassword) }}</p>
                    </div>
                    <div>
                        {{ form_label(profileForm.newPassword.first, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(profileForm.newPassword.first, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(profileForm.newPassword.first) }}
                    </div>
                    <div>
                        {{ form_label(profileForm.newPassword.second, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(profileForm.newPassword.second, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(profileForm.newPassword) }}
                    </div>
                </div>
                <div class="mt-6">
                    <button type="submit"
                            class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700">
                        Save Profile
                    </button>
                </div>
                {{ form_rest(profileForm) }}
                {{ form_end(profileForm) }}
            </div>
        </div>

        {# Family Settings #}
        {% if familyForm is not null %}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-base font-semibold text-gray-900">Family Settings</h2>
            </div>
            <div class="px-6 py-4">
                {{ form_start(familyForm) }}
                <div class="space-y-4">
                    <div>
                        {{ form_label(familyForm.name, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(familyForm.name, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(familyForm.name) }}
                    </div>
                    <div>
                        {{ form_label(familyForm.currency, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                        {{ form_widget(familyForm.currency, {attr: {class: 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(familyForm.currency) }}
                    </div>
                </div>
                <div class="mt-6">
                    <button type="submit"
                            class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700">
                        Save Family Settings
                    </button>
                </div>
                {{ form_end(familyForm) }}
            </div>
        </div>
        {% endif %}

    </div>

    {# Right column: Info + Members #}
    <div class="space-y-6">

        {# Account info #}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-base font-semibold text-gray-900">Account Info</h2>
            </div>
            <div class="px-6 py-4 space-y-3 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Member since</span>
                    <span class="text-gray-900">{{ user.createdAt|date('d M Y') }}</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Role</span>
                    <span class="text-gray-900">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="px-2 py-0.5 rounded text-xs bg-indigo-100 text-indigo-800">Admin</span>
                        {% else %}
                            <span class="px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600">Member</span>
                        {% endif %}
                    </span>
                </div>
                {% if user.telegramUsername %}
                <div class="flex justify-between">
                    <span class="text-gray-500">Telegram</span>
                    <span class="text-gray-900">@{{ user.telegramUsername }}</span>
                </div>
                {% endif %}
                {% if user.telegramChatId %}
                <div class="flex justify-between">
                    <span class="text-gray-500">Chat ID</span>
                    <span class="text-gray-900 font-mono text-xs">{{ user.telegramChatId }}</span>
                </div>
                {% endif %}
                {% if not user.telegramChatId %}
                <p class="text-xs text-gray-400 mt-2">
                    Connect Telegram by sending <code class="bg-gray-100 px-1 rounded">/start</code> to the bot.
                </p>
                {% endif %}
            </div>
        </div>

        {# Family Members #}
        {% if family is not null %}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h2 class="text-base font-semibold text-gray-900">
                    {{ family.name }} Members
                </h2>
                <a href="{{ path('settings_users_new') }}"
                   class="text-xs px-3 py-1.5 bg-indigo-600 text-white rounded hover:bg-indigo-700">
                    + Add
                </a>
            </div>
            <ul class="divide-y divide-gray-100">
                {% for member in family.members %}
                <li class="px-6 py-3 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-900">{{ member.name }}</p>
                        <p class="text-xs text-gray-400">{{ member.email }}</p>
                    </div>
                    <div class="flex items-center gap-2">
                        {% if 'ROLE_ADMIN' in member.roles %}
                            <span class="px-2 py-0.5 rounded text-xs bg-indigo-100 text-indigo-700">Admin</span>
                        {% endif %}
                        {% if member.telegramChatId %}
                            <span class="text-xs text-green-600" title="Telegram connected">✓ TG</span>
                        {% endif %}
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}
