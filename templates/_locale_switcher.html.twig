{% set linkClass = linkClass ?? 'text-indigo-100 hover:text-white' %}
<div class="flex items-center gap-1 text-xs font-medium" aria-label="{{ 'nav.language'|trans }}">
    {% for locale in ['en', 'ru', 'de'] %}
        {% if locale == app.request.locale %}
            <span class="px-1.5 py-1 rounded bg-indigo-700 text-white">{{ locale|upper }}</span>
        {% else %}
            <a href="{{ path('app_locale', {_locale: locale}) }}" class="px-1.5 py-1 rounded {{ linkClass }}" hreflang="{{ locale }}">{{ locale|upper }}</a>
        {% endif %}
    {% endfor %}
</div>
