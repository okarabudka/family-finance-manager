{% extends 'base.html.twig' %}

{% block title %}{{ title }} — Family Finance Manager{% endblock %}

{% block content %}
<div class="mb-6 flex items-center gap-4">
    <a href="{{ path('budget_list') }}" class="text-indigo-600 hover:underline text-sm">&larr; Back to budgets</a>
    <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-xl">
    {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}

    <div>
        {{ form_label(form.category, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.category, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.category) }}
    </div>

    <div>
        {{ form_label(form.plannedAmount, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.plannedAmount, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
        {{ form_errors(form.plannedAmount) }}
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            {{ form_label(form.year, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.year, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.year) }}
        </div>
        <div>
            {{ form_label(form.month, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.month, {attr: {class: 'block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
            {{ form_errors(form.month) }}
        </div>
    </div>

    <div class="flex gap-3 pt-2">
        <button type="submit"
                class="px-6 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700">
            Save
        </button>
        <a href="{{ path('budget_list') }}"
           class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200">
            Cancel
        </a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
