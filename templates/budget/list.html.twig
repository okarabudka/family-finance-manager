{% extends 'base.html.twig' %}

{% block title %}{{ 'budget.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'budget.title'|trans }}</h1>
        <p class="text-sm text-gray-500 mt-1">{{ year }}-{{ '%02d'|format(month) }}</p>
    </div>
    <a href="{{ path('budget_new') }}"
       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
        + {{ 'budget.new'|trans }}
    </a>
</div>

{# Month navigation #}
<div class="mb-4 flex gap-2 items-center">
    {% set prevMonth = month - 1 %}
    {% set prevYear  = year %}
    {% if prevMonth < 1 %}{% set prevMonth = 12 %}{% set prevYear = year - 1 %}{% endif %}
    {% set nextMonth = month + 1 %}
    {% set nextYear  = year %}
    {% if nextMonth > 12 %}{% set nextMonth = 1 %}{% set nextYear = year + 1 %}{% endif %}

    <a href="{{ path('budget_list', {year: prevYear, month: prevMonth}) }}"
       class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-50">
        &larr; {{ 'common.previous'|trans }}
    </a>
    <span class="px-3 py-1 text-sm font-medium text-gray-700">
        {{ year }}-{{ '%02d'|format(month) }}
    </span>
    <a href="{{ path('budget_list', {year: nextYear, month: nextMonth}) }}"
       class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-50">
        {{ 'common.next'|trans }} &rarr;
    </a>
</div>

{% if budgets is empty %}
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
        {{ 'budget.empty'|trans }}
        <a href="{{ path('budget_new') }}" class="text-indigo-600 hover:underline ml-1">{{ 'budget.create_first'|trans }}</a>
    </div>
{% else %}
<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'budget.column.category'|trans }}</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">{{ 'budget.column.planned_amount'|trans }}</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'budget.column.period'|trans }}</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {% for budget in budgets %}
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-gray-900">
                    {{ budget.category.name }}
                </td>
                <td class="px-4 py-3 text-right font-semibold text-gray-800">
                    {{ budget.plannedAmount|number_format(2, '.', ',') }} EUR
                </td>
                <td class="px-4 py-3 text-gray-500">
                    {{ budget.year }}-{{ '%02d'|format(budget.month) }}
                </td>
                <td class="px-4 py-3 text-center space-x-2">
                    <a href="{{ path('budget_edit', {id: budget.id}) }}"
                       class="text-indigo-600 hover:underline text-xs">{{ 'common.edit'|trans }}</a>
                    <form method="post" action="{{ path('budget_delete', {id: budget.id}) }}"
                          class="inline"
                          onsubmit="return confirm({{ 'budget.confirm_delete'|trans|json_encode }});">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_budget_' ~ budget.id) }}">
                        <button type="submit" class="text-red-600 hover:underline text-xs">{{ 'common.delete'|trans }}</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
