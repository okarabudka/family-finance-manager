{% extends 'base.html.twig' %}

{% block title %}Imports — Family Finance Manager{% endblock %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Import Files</h1>
    <a href="{{ path('import_pending') }}"
       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-amber-600 hover:bg-amber-700">
        Pending Transactions
    </a>
</div>

{% if imports.getTotalItemCount() == 0 %}
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
        No import files found.
    </div>
{% else %}
<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Filename</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Account</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Upload Date</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Imported</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Skipped</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {% set statusColors = {
                'pending':    'bg-yellow-100 text-yellow-700',
                'processing': 'bg-blue-100 text-blue-700',
                'done':       'bg-green-100 text-green-700',
                'failed':     'bg-red-100 text-red-700'
            } %}
            {% for import in imports %}
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-gray-900">
                    {{ import.originalFilename }}
                    <div class="text-xs text-gray-400 font-normal">{{ import.format|upper }}</div>
                </td>
                <td class="px-4 py-3 text-gray-500">{{ import.account.name }}</td>
                <td class="px-4 py-3 text-gray-500">{{ import.createdAt|date('Y-m-d H:i') }}</td>
                <td class="px-4 py-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                 {{ statusColors[import.status.value] ?? 'bg-gray-100 text-gray-500' }}">
                        {{ import.status.value|capitalize }}
                    </span>
                    {% if import.errorMessage %}
                        <div class="text-xs text-red-500 mt-1">{{ import.errorMessage|slice(0, 80) }}</div>
                    {% endif %}
                </td>
                <td class="px-4 py-3 text-right text-gray-700">{{ import.totalRows }}</td>
                <td class="px-4 py-3 text-right text-green-600">{{ import.importedRows }}</td>
                <td class="px-4 py-3 text-right text-gray-400">{{ import.skippedRows }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Pagination #}
<div class="mt-4 flex justify-center">
    {{ knp_pagination_render(imports) }}
</div>
{% endif %}
{% endblock %}
