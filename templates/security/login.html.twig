{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block content %}
<div class="flex justify-end">
    {% include '_locale_switcher.html.twig' with {linkClass: 'text-gray-500 hover:text-indigo-700'} %}
</div>
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h1 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
                {{ 'app.name'|trans }}
            </h1>
            <p class="mt-2 text-center text-sm text-gray-600">{{ 'security.login.subtitle'|trans }}</p>
        </div>

        {% if error %}
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded" role="alert">
            {{ error.messageKey | trans(error.messageData, 'security') }}
        </div>
        {% endif %}

        {{ form_start(form, {attr: {class: 'mt-8 space-y-6', novalidate: 'novalidate'}}) }}
            <div class="space-y-4">
                <div>
                    {{ form_label(form.email, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.email, {attr: {class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div>
                    {{ form_label(form.password, null, {label_attr: {class: 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.password, {attr: {class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border'}}) }}
                    {{ form_errors(form.password) }}
                </div>
                <div class="flex items-center">
                    {{ form_widget(form._remember_me, {attr: {class: 'h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded'}}) }}
                    {{ form_label(form._remember_me, null, {label_attr: {class: 'ml-2 block text-sm text-gray-900'}}) }}
                </div>
            </div>

            <div>
                <button type="submit"
                        class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    {{ 'security.login.submit'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
